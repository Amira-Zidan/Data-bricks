{
  "datasets": [
    {
      "name": "f1b7c98a",
      "displayName": "Location Data",
      "queryLines": [
        "select `latitude`, `longitude`, `GHG emissions mtons CO2e` as emission\r\n",
        "from emissions_data;"
      ],
      "catalog": "emission",
      "schema": "default"
    },
    {
      "name": "eacddaee",
      "displayName": "County Emissions Per Capita Insights",
      "queryLines": [
        " select county_state_name, population,\r\n",
        " cast(cast(replace(`GHG emissions mtons CO2e`, ',', '') as double) / cast(population as double) as decimal (10,2)) as emission_per_population\r\n",
        "from emission.default.emissions_data\r\n",
        "order by emission_per_population desc\r\n",
        " ;\r\n"
      ]
    },
    {
      "name": "f418242a",
      "displayName": "Emissions VS State_abber",
      "queryLines": [
        "select state_abbr, sum(cast(replace(`GHG emissions mtons CO2e`, ',', '') as double)) as Emissions  \r\n",
        "from emission.default.emissions_data\r\n",
        "group by state_abbr\r\n",
        "order by emissions desc\r\n",
        "limit 10\r\n",
        ";"
      ],
      "catalog": "emission",
      "schema": "default"
    },
    {
      "name": "0f82b119",
      "displayName": "Total emissions per county name&population",
      "queryLines": [
        "select county_state_name, population,\r\n",
        "cast(replace(`GHG emissions mtons CO2e`, ',', '') as double) as Total_emissions\r\n",
        "from emission.default.emissions_data\r\n",
        "order by Total_emissions desc\r\n",
        "limit 10\r\n",
        " ;"
      ],
      "catalog": "emission",
      "schema": "default"
    }
  ],
